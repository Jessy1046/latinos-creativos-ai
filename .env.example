# Copia este archivo como .env.local y agrega tus claves. Nunca lo subas a git.

# RentCast (https://app.rentcast.io/app/api). Sin clave, la app usa el modo DEMOSTRACIÓN.
# Cada consulta consume créditos de tu plan.
RENTCAST_API_KEY=

# Contraseña para abrir la app cuando se publica con un link (vacía = sin contraseña).
APP_PASSWORD=
